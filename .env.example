# Строка подключения к Postgres на Neon (free tier).
# Формат: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Секрет для защиты эндпоинтов /api/cron/*. Любой внешний планировщик
# должен слать заголовок Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# Секрет Auth.js для подписи сессий (генерируется `openssl rand -base64 32`).
AUTH_SECRET=

# Учётные данные администратора. Логин не может быть 'admin'/'root';
# пароль от 20 символов. Хеш пароля печатается командой `pnpm admin:hash`.
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=

# Personal access token для API SourceCraft (Authorization: Bearer $SOURCECRAFT_PAT).
SOURCECRAFT_PAT=

# API SourceCraft AppSec. Результаты сканирования он отдаёт только участникам
# репозитория, поэтому Pulse ходит туда токеном владельца (раздел «Мои репозитории»).
APPSEC_API_URL=https://appsec.sourcecraft.tech

# Каталог публичных репозиториев SourceCraft (GET /repos). Воркер обходит его раз
# в CATALOG_SYNC_HOURS часов (0 — не обходить); на Vercel — внешний вызов
# /api/cron/catalog. CATALOG_AUTO_ANALYZE — сколько неоценённых репозиториев
# каталога ставить на оценку, когда очередь пуста (0 — выключено: каждая оценка —
# клон и вызовы модели, следите за AI_MONTHLY_BUDGET_RUB).
CATALOG_SYNC_HOURS=24
CATALOG_AUTO_ANALYZE=0

# Плановый пересчёт публичного рейтинга: сразу, если репозиторий изменился после
# анализа; по возрасту (PUBLIC_REFRESH_DAYS дней) — только если задано больше 0.
# Воркер ставит по PUBLIC_REFRESH_BATCH за запуск (0 — выключено); на Vercel —
# внешний вызов /api/cron/refresh-public раз в час.
# Главный механизм — проверка новых коммитов в 00:00 и 12:00 МСК
# (/api/cron/commit-check): без коммитов оценка остаётся, с ними — переоценка.
PUBLIC_REFRESH_DAYS=0
PUBLIC_REFRESH_BATCH=2

# OpenAI-совместимый роутер моделей (RouterAI).
# База, ключ, и выбранная модель. Роутер сам возвращает usage.cost в USD.
AI_BASE_URL=https://routerai.ru/api/v1
AI_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash

# Месячный лимит расходов на ИИ в рублях; при превышении модель отключается,
# анализы продолжают считаться без AI-рубрики.
AI_MONTHLY_BUDGET_RUB=150

# Курс доллара к рублю для пересчёта usage.cost из USD в RUB.
USD_RUB_RATE=95

# Часовой пояс суточного пересчёта своих репозиториев (вкладка «Мои репозитории»):
# в 00:00 по нему подтверждённые репозитории ставятся на новую оценку.
# В docker это делает воркер; на Vercel — внешний вызов /api/cron/refresh-badges.
BADGE_REFRESH_TZ=Europe/Moscow

# Ключ шифрования личных токенов SourceCraft (автосинхронизация «Моих
# репозиториев»): 32 байта, `openssl rand -base64 32`. Если не задан, ключ
# выводится из AUTH_SECRET. Смена ключа делает сохранённые токены нечитаемыми —
# пользователей попросят ввести токен заново.
TOKEN_ENCRYPTION_KEY=

# Адрес приложения для Auth.js и доверие к заголовкам прокси (Vercel, Caddy).
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Вход через Яндекс ID (oauth.yandex.ru): ClientID и Client secret приложения.
# Redirect URI приложения: <адрес сайта>/api/auth/callback/yandex.
# Если не заданы, кнопка «Войти через Яндекс ID» скрыта, работает вход по почте.
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=
