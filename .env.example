# Строка подключения к Postgres на Neon (free tier).
# Формат: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Секрет для защиты эндпоинтов /api/cron/*. Любой внешний планировщик
# должен слать заголовок Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# Секрет Auth.js для подписи сессий (генерируется `openssl rand -base64 32`).
AUTH_SECRET=

# Учётные данные администратора. Значения задаются вручную,
# хэш пароля печатается командой `pnpm admin:hash` (появится на Этапе 7).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Personal access token для API SourceCraft (Authorization: Bearer $SOURCECRAFT_PAT).
SOURCECRAFT_PAT=

# Активный провайдер модели: deepseek | yandexgpt
AI_PROVIDER=deepseek

# API-ключ DeepSeek (OpenAI-совместимый протокол).
DEEPSEEK_API_KEY=

# API-ключ Яндекса и идентификатор папки для вызова YandexGPT.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Месячный лимит расходов на ИИ в рублях; при превышении модель отключается.
AI_MONTHLY_BUDGET_RUB=1000

# Курс доллара к рублю (для пересчёта долларовых тарифов моделей).
USD_RUB_RATE=95
