# Шаблон .env для docker compose. Скопируйте в /opt/pulse/.env
# перед первым запуском. setup.sh делает это автоматически.

# ---------- обязательные ----------

DOMAIN=source-craft-pulse.tech

# База в контейнере postgres. Пароль сгенерируйте случайный (не менее 24 hex).
DB_PASSWORD=

# Секрет Auth.js (>=32 байт, hex). openssl rand -hex 32
AUTH_SECRET=

# Токен SourceCraft API
SOURCECRAFT_PAT=

# RouterAI (OpenAI-совместимый роутер)
AI_BASE_URL=https://routerai.ru/v1
AI_API_KEY=
AI_MODEL=deepseek/deepseek-v3.1-flash
AI_MONTHLY_BUDGET_RUB=500

# Админка
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=

# Для внешних cron-эндпоинтов (не обязателен, но пусть будет)
CRON_SECRET=
