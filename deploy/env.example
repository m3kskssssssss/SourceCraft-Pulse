# Шаблон .env для docker compose. Скопируйте в /opt/pulse/.env
# перед первым запуском. setup.sh делает это автоматически.

# ---------- обязательные ----------

DOMAIN=source-craft-pulse.tech

# Какой Caddyfile монтировать:
#   Caddyfile.docker     — свой TLS через Let's Encrypt (нужен исходящий ACME);
#   Caddyfile.behind-proxy — HTTP, когда TLS терминируется впереди
#                            (балансировщик провайдера, Cloudflare).
#   Caddyfile.manual-tls   — сертификат, выпущенный вручную, из deploy/certs.
CADDYFILE=Caddyfile.docker

# Образ приложения: готовый из ghcr (собирается в GitHub Actions) или
# pulse-app:latest, если собирали на сервере руками.
PULSE_IMAGE=ghcr.io/m3kskssssssss/pulse:main

# База в контейнере postgres. Пароль сгенерируйте случайный (не менее 24 hex).
DB_PASSWORD=

# Секрет Auth.js (>=32 байт, hex). openssl rand -hex 32
AUTH_SECRET=

# Токен SourceCraft API
SOURCECRAFT_PAT=

# RouterAI (OpenAI-совместимый роутер)
AI_BASE_URL=https://routerai.ru/v1
AI_API_KEY=
AI_MODEL=deepseek/deepseek-v3.1-flash
AI_MONTHLY_BUDGET_RUB=500

# Админка
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=

# Для внешних cron-эндпоинтов (не обязателен, но пусть будет)
CRON_SECRET=
