[Unit]
Description=Pulse Next.js app
After=network.target

[Service]
Type=simple
User=pulse
Group=pulse
WorkingDirectory=/opt/pulse
EnvironmentFile=/opt/pulse/.env
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15

# Ограничения безопасности.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

# Логи.
StandardOutput=append:/var/log/pulse/app.log
StandardError=append:/var/log/pulse/app.err.log

[Install]
WantedBy=multi-user.target
