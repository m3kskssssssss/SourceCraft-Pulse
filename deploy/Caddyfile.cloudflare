# Вариант для домена за Cloudflare: сертификат живёт у них, до нас идёт
# обычный HTTP по 80-му порту. ACME на сервере не нужен — ровно поэтому
# этот файл и существует: исходящие к Let's Encrypt с ВМ не проходят.
#
# Включается через CADDYFILE=Caddyfile.cloudflare в .env.
# В Cloudflare при этом: DNS-записи Proxied (оранжевое облако),
# SSL/TLS → Flexible, Always Use HTTPS → On.

:80 {
	encode zstd gzip

	# app — имя сервиса в compose. Docker DNS резолвит по имени.
	reverse_proxy app:3000

	@badge path_regexp badge ^/api/badge/.+\.svg$
	header @badge Cache-Control "public, max-age=300, stale-while-revalidate=86400"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
}
